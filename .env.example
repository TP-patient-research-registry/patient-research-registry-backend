# =============================================================================================
# Patient Research Registry - backend configuration.
# Local dev: copy to ./.env   |   Production: copy to deploy/.env (used by docker compose).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================================================

# --- Django ---
# DJANGO_SETTINGS_MODULE=config.settings.dev        # dev | prod | test (the Docker image defaults to prod)
SECRET_KEY=change-me
DEBUG=False
# Must include the public domain AND "backend" (the frontend container calls http://backend:8000).
ALLOWED_HOSTS=registry.example.sk,backend
CSRF_TRUSTED_ORIGINS=https://registry.example.sk
FRONTEND_URL=https://registry.example.sk
LOG_LEVEL=INFO
# SESSION_COOKIE_AGE=43200
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False
# ADMIN_EMAILS=admin@example.sk

# --- Encryption of health data (GDPR art. 9) ---
# Different from SECRET_KEY. NEVER change or lose it: encrypted data becomes unreadable.
# Keep an offline copy in addition to the encrypted backups (deploy/backup.sh).
FIELD_ENCRYPTION_KEY=change-me-too

# --- Database (PostgreSQL 16) ---
# Production: host is the `postgres` service; password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://registry:change-me-db@postgres:5432/registry
POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=change-me-db
# CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1

# --- Email (django-environ EMAIL_URL syntax) ---
# smtp+tls://user:password@smtp.example.sk:587   |   consolemail://   (dev)
EMAIL_URL=smtp+tls://user:password@smtp.example.sk:587
DEFAULT_FROM_EMAIL=Patient Research Registry <noreply@registry.example.sk>

# --- CORS (off: frontend and API share one origin behind nginx) ---
CORS_ENABLED=False
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Deployment (deploy/docker-compose.yml) ---
DOMAIN=registry.example.sk
BACKEND_IMAGE=ghcr.io/your-org/patient-research-registry-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/patient-research-registry-frontend:latest
# GUNICORN_WORKERS=4
